# 本段階はモック専用。実際の秘密値は書かず、安全な環境設定を使用してください。
INTEGRATION_MODE=mock
# ローカル認証用。代表と閲覧用はそれぞれ異なる32文字以上のランダム値。
INTEGRATION_ADMIN_TOKEN=
INTEGRATION_VIEWER_TOKEN=
# 仮名化用、32文字以上。変更は既存IDとの対応を失うため鍵管理設計が必要。
CRM_PSEUDONYM_KEY=
# Webhook署名検証。モック時はローカル合成値のみ。LINE開設済みでもAPI設定は別途必要。
LINE_CHANNEL_SECRET=
LINE_EXPECTED_DESTINATION=
# 将来用・現段階では読み取りも送信も行わない。
LINE_CHANNEL_ACCESS_TOKEN=
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=
# 予約サービス未選定。実カレンダー用の認証形式は選定後に決める。
BOOKING_PROVIDER=unselected
# ローカル閲覧時のみ: 代表または閲覧トークンを安全なプロセス環境から渡す。
INTEGRATION_SESSION_TOKEN=
# 第9段階: カード記載番号の重複確認用HMAC鍵。32文字以上のランダム値。
# アプリはプロセス環境からのみ読む。.envは自動読込しない。チャットやコードに値を記載しない。
# 一度使用した鍵の変更は重複防止を壊すため、別途計画した移行が必要。
SEMINAR_CARD_HMAC_KEY=

# 生成AI試験第1弾。モックはキー不要。設定ファイルは自動読込しない。
# 今回の開発・検証では実APIを呼び出さない。実API利用は別途代表承認後のみ。
VIOLET_LLM_LIVE_ENABLED=0
OPENAI_API_KEY=
# Chat CompletionsのJSON出力とmax_completion_tokensに対応する、利用可能なモデル名を後で指定。
VIOLET_LLM_MODEL=
# 正式価格を確認後、USD/100万トークン単位で設定。未設定・不正値は実行停止。
VIOLET_LLM_INPUT_USD_PER_MILLION=
VIOLET_LLM_OUTPUT_USD_PER_MILLION=
VIOLET_LLM_PRICE_REFERENCE=
VIOLET_LLM_TIMEOUT_SECONDS=20
VIOLET_LLM_MAX_OUTPUT_TOKENS=1500
